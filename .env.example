PORT=5000

# MongoDB Atlas or local connection string
MONGO_URI=mongodb://127.0.0.1:27017/cinema_booking_system

# JWT signing secret
JWT_SECRET=replace_with_a_secure_secret

# Frontend origin and QR link base
FRONTEND_URL=http://localhost:3000

# Gmail credentials for OTP and password reset emails
EMAIL=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Google Sign-In client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis Cloud credentials
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
REDIS_HOST=your-redis-host
REDIS_PORT=14433

# Admin wallet transfer details returned during booking creation
ADMIN_WALLET_QR_URL=https://example.com/static-admin-wallet-qr.png
ADMIN_WALLET_ACCOUNT_NAME=Cinema Booking Admin
ADMIN_WALLET_ACCOUNT_NUMBER=1234567890
ADMIN_WALLET_BANK_NAME=Example Bank

# Pending booking hold duration in minutes, allowed range 15-30
BOOKING_HOLD_MINUTES=15
